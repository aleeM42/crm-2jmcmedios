# ============================================
# CRM 2jmcMedios — Variables de Producción
# ============================================
# INSTRUCCIONES:
# 1. Copiar este archivo y renombrarlo como ".env.prod"
# 2. Completar TODOS los valores marcados con <CAMBIAR>
# 3. NUNCA subir ".env.prod" a git (está en .gitignore)
# ============================================

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<CAMBIAR: contraseña segura>
POSTGRES_DB=crm_2jmc
POSTGRES_PORT=5432

# --- JWT (mínimo 32 caracteres aleatorios) ---
JWT_SECRET=<CAMBIAR: secreto largo y aleatorio>

# --- CORS: tu dominio en Cloudflare (sin trailing slash) ---
# Ejemplo: https://crm.tuempresa.com
CORS_ORIGIN=<CAMBIAR: https://tu-subdominio.tudominio.com>

# --- pgAdmin (panel de administración de BD, puerto 5051) ---
PGADMIN_EMAIL=<CAMBIAR: tu@email.com>
PGADMIN_PASSWORD=<CAMBIAR: contraseña segura>

# --- Cloudflare Tunnel ---
# Obtener desde: Cloudflare Zero Trust → Networks → Tunnels → tu túnel → Overview
CLOUDFLARE_TUNNEL_TOKEN=<CAMBIAR: token completo del túnel>
